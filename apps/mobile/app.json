{
  "expo": {
    "name": "שכונה",
    "slug": "shkuna",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "shkuna",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1a0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.shkuna.mobile"
    },
    "android": {
      "package": "app.shkuna.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f1a0f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
