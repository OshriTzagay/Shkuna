{
  "expo": {
    "name": "שכונה",
    "slug": "shkuna",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "shkuna",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.shkuna.mobile"
    },
    "android": {
      "package": "app.shkuna.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
